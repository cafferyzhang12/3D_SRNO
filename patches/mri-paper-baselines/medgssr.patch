+// One thread per Gaussian. Forward and backward visit the same 3-sigma
+// ellipsoid (paper Eq. 7); the AABB merely skips points outside its support.
+template <bool Backward>
+__global__ void splat(
+    int count, int depth, int height, int width,
+    const float* centers, const float* points, const float* intensity,
+    const float* inverse_covariance, const float* axis_std, float* output,
+    const float* grad_output, float* grad_centers, float* grad_intensity,
+    float* grad_inverse_covariance) {
+    const int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= count) return;
+    const float* center = centers + index * 3;
+    const float* inverse = inverse_covariance + index * 9;
+    const float* std = axis_std + index * 3;
+    const int sizes[3] = {depth, height, width};
+    int low[3], high[3];
+    for (int axis = 0; axis < 3; ++axis) {
+        const float radius = 3.0f * std[axis];
+        // Grid coordinates are voxel centers, (i + 0.5) / size.
+        low[axis] = max(0, static_cast<int>(floorf((center[axis] - radius) * sizes[axis] - 0.5f)));
+        high[axis] = min(sizes[axis] - 1, static_cast<int>(ceilf((center[axis] + radius) * sizes[axis] - 0.5f)));
+    }
+    float center_gradient[3] = {};
+    float covariance_gradient[9] = {};
+    float intensity_gradient = 0.0f;
+    for (int z = low[0]; z <= high[0]; ++z) {
+        for (int y = low[1]; y <= high[1]; ++y) {
+            for (int x = low[2]; x <= high[2]; ++x) {
+                const int voxel = (z * height + y) * width + x;
+                float delta[3], product[3] = {};
+                for (int axis = 0; axis < 3; ++axis) {
+                    delta[axis] = points[voxel * 3 + axis] - center[axis];
+                }
+                float distance = 0.0f;
+                for (int i = 0; i < 3; ++i) {
+                    for (int j = 0; j < 3; ++j) {
+                        product[i] += inverse[i * 3 + j] * delta[j];
+                    }
+                    distance += delta[i] * product[i];
+                }
+                if (distance >= 9.0f) continue;
+                const float weight = __expf(-0.5f * distance);
+                if constexpr (Backward) {
+                    const float weighted_grad = grad_output[voxel] * weight;
+                    const float common = weighted_grad * intensity[index];
+                    intensity_gradient += weighted_grad;
+                    for (int i = 0; i < 3; ++i) {
+                        float transpose_product = 0.0f;
+                        for (int j = 0; j < 3; ++j) {
+                            transpose_product += inverse[j * 3 + i] * delta[j];
+                            covariance_gradient[i * 3 + j] -= 0.5f * common * delta[i] * delta[j];
+                        }
+                        center_gradient[i] += 0.5f * common * (product[i] + transpose_product);
